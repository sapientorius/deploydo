{
  "profiles": {
    "default": {
      "protocol": "sftp",
      "host": "yourhost.example",
      "port": 22,
      "username": "deploy",
      "sourcePath": "dist",
      "remotePath": "/var/www/html",
      "exclude": [
        "**/*.map"
      ],
      "build": {
        "command": "npm run build"
      },
      "auth": {
        "passwordEnv": "DEPLOYDO_PASSWORD"
      },
      "sync": {
        "useManifest": true
      }
    }
  }
}
